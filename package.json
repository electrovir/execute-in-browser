{
    "name": "execute-in-browser",
    "version": "1.0.10",
    "description": "Directly run a single file in a browser.",
    "keywords": [
        "execute",
        "script",
        "browser"
    ],
    "homepage": "https://github.com/electrovir/execute-in-browser",
    "bugs": {
        "url": "https://github.com/electrovir/execute-in-browser/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/execute-in-browser.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "bin": {
        "b-run": "bin.js"
    },
    "scripts": {
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "tsx src/cli.script.ts test-files/simple.script.ts",
        "test:all": "npm run compile && runstorm --names spelling,format,deps,lint \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "dependencies": {
        "@augment-vir/common": "^32.2.1",
        "@augment-vir/node": "^32.2.1",
        "@virmator/frontend": "^14.30.2",
        "package-up": "^5.0.0",
        "portfinder": "^1.0.38",
        "tsx": "^4.23.1",
        "vite-tsconfig-paths": "^6.1.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.1.2",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.3.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "npm-check-updates": "^23.0.0",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.6",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.3",
        "vite": "^8.1.5"
    },
    "peerDependencies": {
        "vite": "*"
    },
    "engines": {
        "node": ">=22"
    }
}
